# Copy to <DEPLOY_PATH>/.env on the VPS. Never commit the real file.

# ---- compose / Caddy ----
# Public domain(s); Caddy gets TLS certificates for them
DOMAIN=football-planner.ru
# Uncomment to run Postgres (and daily backups) on this host
# COMPOSE_PROFILES=postgres
# openssl rand -hex 24; the same password goes into DATABASE_URL below
# POSTGRES_PASSWORD=
# BACKUP_KEEP_DAYS=14

# ---- server (all keys: ../.env.example) ----
# Local profile: postgres://football:<POSTGRES_PASSWORD>@postgres:5432/football
# Or a managed Postgres
DATABASE_URL=
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
PUBLIC_URL=https://football-planner.ru
LOG_LEVEL=info

# Telegram (optional). Webhook mode needs the public HTTPS URL above.
BOT_TOKEN=
BOT_MODE=webhook
BOT_WEBHOOK_URL=https://football-planner.ru
# openssl rand -hex 32
BOT_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
# Log in with Telegram and the Mini App (README: Telegram login and Mini App)
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_APP_URL=

# Time zone of the venues, e.g. Europe/Moscow
TIME_ZONE=

# Weather for matches without a city of their own, e.g. 47.2357 and 39.7015, and the
# name the match form shows as the default city
# WEATHER_DEFAULT_LAT=
# WEATHER_DEFAULT_LON=
# WEATHER_DEFAULT_CITY=Ростов-на-Дону
