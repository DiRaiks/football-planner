# Copy to <DEPLOY_PATH>/.env on the VPS. Never commit the real file.

# ---- compose / Caddy ----
# Public domain(s); Caddy gets TLS certificates for them
DOMAIN=football-planner.ru
# Uncomment to run MongoDB (and daily backups) on this host
# COMPOSE_PROFILES=mongo
# BACKUP_KEEP_DAYS=14

# ---- server (all keys: ../.env.example) ----
# Atlas: mongodb+srv://user:password@cluster.example.mongodb.net/football
# Local profile: mongodb://mongo:27017/football
MONGO_URI=
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
PUBLIC_URL=https://football-planner.ru
LOG_LEVEL=info

# Telegram (optional). Webhook mode needs the public HTTPS URL above.
BOT_TOKEN=
BOT_MODE=webhook
BOT_WEBHOOK_URL=https://football-planner.ru
# openssl rand -hex 32
BOT_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

# Time zone of the venues, e.g. Europe/Moscow
TIME_ZONE=

# Weather for matches without coordinates
WEATHER_DEFAULT_LAT=
WEATHER_DEFAULT_LON=
