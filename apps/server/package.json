{
  "name": "football-planner-server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "set-role": "node --env-file-if-exists=../../.env scripts/set-role.mjs",
    "predev": "npm run build --workspace @football-planner/shared",
    "prebuild": "npm run build --workspace @football-planner/shared",
    "pretypes": "npm run build --workspace @football-planner/shared",
    "pretest": "npm run build --workspace @football-planner/shared",
    "migrate-from-mongo": "tsx --env-file-if-exists=../../.env scripts/migrate-from-mongo.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/football-planner.git"
  },
  "author": "DiRaiks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DiRaiks/football-planner/issues"
  },
  "homepage": "https://github.com/DiRaiks/football-planner#readme",
  "dependencies": {
    "@dirai-kit/fastify": "^1.0.0",
    "@dirai-kit/pg": "^1.0.0",
    "@dirai-kit/tg": "^1.5.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@football-planner/shared": "*",
    "@prometheus-io/client": "^0.16.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "fastify-tsconfig": "^3.0.0",
    "mongodb": "^7.7.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
