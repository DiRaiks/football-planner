{
  "name": "football-planner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier . --check",
    "commitlint": "commitlint --from=HEAD~1",
    "prepare": "husky",
    "build": "npm run build --workspaces --if-present",
    "types": "npm run types --workspaces --if-present",
    "dev": "npm run dev --workspace apps/server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/football-planner.git"
  },
  "author": "DiRaiks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DiRaiks/football-planner/issues"
  },
  "homepage": "https://github.com/DiRaiks/football-planner#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "npm@11.4.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11.21"
  },
  "type": "module"
}
