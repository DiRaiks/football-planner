{
  "name": "football-planner-server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "types": "tsc --noEmit",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --moduleResolution node --outDir ./dist/cjs --removeComments --verbatimModuleSyntax false && echo > ./dist/cjs/package.json '{\"type\":\"commonjs\"}'",
    "build:esm": "tsc --project tsconfig.build.json --outDir ./dist/esm && echo > ./dist/esm/package.json '{\"type\":\"module\",\"sideEffects\":false}'",
    "build:types": "tsc --project tsconfig.build.json  --declarationDir ./dist/types --emitDeclarationOnly --declaration --declarationMap",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "start": "tsc && node dist/esm/index.js",
    "watch": "tsc --watch --preserveWatchOutput --pretty",
    "dev": "nodemon",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/football-planner.git"
  },
  "author": "DiRaiks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DiRaiks/football-planner/issues"
  },
  "homepage": "https://github.com/DiRaiks/football-planner#readme",
  "dependencies": {
    "@fastify/env": "^5",
    "@fastify/jwt": "^9.1.0",
    "fastify": "^5",
    "fastify-plugin": "^5",
    "mongoose": "^8.3.2",
    "telegraf": "^4.16.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.6.1",
    "fastify-tsconfig": "^2.0.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
