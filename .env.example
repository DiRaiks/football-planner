# --- Required ---
PORT=3000
# Postgres: postgres://user:password@localhost:5432/football
# (MONGO_URI of older versions is no longer read; README: Moving from MongoDB)
DATABASE_URL=
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# --- Optional ---
JWT_EXPIRES_IN=30d
# json (production) or pretty (local development)
LOG_FORMAT=json
# Telegram notifications are disabled when empty
BOT_TOKEN=
# polling (local development) or webhook (production, needs a public HTTPS URL)
BOT_MODE=polling
# Webhook mode: public base URL of this API and a random secret (16+ chars of A-Z a-z 0-9 _ -)
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to run admin bot commands
TELEGRAM_ADMIN_IDS=
# Public site URL used in bot messages, e.g. https://football-planner.ru
PUBLIC_URL=
# "Log in with Telegram": Client ID and Secret from @BotFather (Login Widget), with
# <PUBLIC_URL>/auth/telegram registered there as a redirect URI
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Mini App link from @BotFather, e.g. https://t.me/<bot>/<app>; "Открыть" opens it
TELEGRAM_APP_URL=
# Comma-separated allowed origins of the frontend
CORS_ORIGINS=
# Behind a reverse proxy (Caddy/nginx): number of proxy hops (usually 1) or proxy IPs/CIDRs.
# Leave empty when the API is exposed directly. `true` is refused as unsafe.
TRUST_PROXY=
# Max login/registration attempts per IP per minute
AUTH_RATE_LIMIT_MAX=10
# IANA time zone of the venues: match times are entered in it (e.g. Europe/Moscow)
TIME_ZONE=Europe/Moscow
# Weather location for events without coordinates (Open-Meteo, no API key needed).
# Weather is disabled when unset.
WEATHER_DEFAULT_LAT=
WEATHER_DEFAULT_LON=
# Log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
